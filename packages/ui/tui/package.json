{
  "name": "@x1a0f3n9/dsh-tui",
  "description": "Interactive terminal front door for DeepSeek Harness agents: the tui profile bundle over dsh-base, built on the ported Ink core.",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/ui/tui"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#dsh-ecosystem-spec/tui-channel": "./dsh-ecosystem-spec/protocols/tui-channel.js"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./working-activity": {
      "types": "./lib/types/working-activity.d.ts",
      "default": "./lib/types/working-activity.js"
    },
    "./workspaces": {
      "types": "./lib/types/workspaces.d.ts",
      "default": "./lib/types/workspaces.js"
    },
    "./command-trees": {
      "types": "./lib/types/command-trees.d.ts",
      "default": "./lib/types/command-trees.js"
    },
    "./settings-sections": {
      "types": "./lib/types/settings-sections.d.ts",
      "default": "./lib/types/settings-sections.js"
    },
    "./scenes": {
      "types": "./lib/types/scenes.d.ts",
      "default": "./lib/types/scenes.js"
    },
    "./extensions": {
      "types": "./lib/types/extensions.d.ts",
      "default": "./lib/types/extensions.js"
    },
    "./plugin-host": {
      "types": "./lib/types/plugin-host.d.ts",
      "default": "./lib/types/plugin-host.js"
    },
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/types/api.js"
    },
    "./test-utils": {
      "types": "./lib/types/test-utils.d.ts",
      "default": "./lib/types/test-utils.js"
    },
    "./jsx-runtime": {
      "types": "./lib/types/jsx-runtime.d.ts",
      "default": "./lib/types/jsx-runtime.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "dsh-ecosystem-spec/registry",
    "dsh-ecosystem-spec/protocols",
    "dsh-ecosystem-spec/schemas",
    "presets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "clean": "node scripts/clean-lib.mjs",
    "build:dsh-std": "pnpm --dir vendor/dsh-std install --frozen-lockfile --ignore-scripts && pnpm --dir vendor/dsh-std --filter @dsh-std/core --filter @dsh-std/manifest --filter @dsh-std/connection --filter @dsh-std/presentation --filter @dsh-std/command --filter @dsh-std/storage --filter @dsh-std/messages -r build",
    "generate-pet-frames": "node scripts/generate-pet-frames.mjs"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@deepseek-ai/schemastery": "workspace:^",
    "@x1a0f3n9/dsh-agent": "workspace:^",
    "@x1a0f3n9/dsh-agent-instructions": "workspace:^",
    "@x1a0f3n9/dsh-agent-presets": "workspace:^",
    "@x1a0f3n9/dsh-atomic-write": "workspace:^",
    "@x1a0f3n9/dsh-code-runtime-worker-thread": "workspace:^",
    "@x1a0f3n9/dsh-commands": "workspace:^",
    "@x1a0f3n9/dsh-cordis-host-runner": "workspace:^",
    "@x1a0f3n9/dsh-llm": "workspace:^",
    "@x1a0f3n9/dsh-session": "workspace:^",
    "@x1a0f3n9/dsh-settings": "workspace:^",
    "@x1a0f3n9/dsh-skill": "workspace:^",
    "@x1a0f3n9/dsh-storage": "workspace:^",
    "@x1a0f3n9/dsh-storage-domain": "workspace:^",
    "@x1a0f3n9/dsh-storage-json": "workspace:^",
    "@x1a0f3n9/dsh-system-prompt": "workspace:^",
    "@x1a0f3n9/dsh-tool-ask-user": "workspace:^",
    "@x1a0f3n9/dsh-tool-subagent": "workspace:^",
    "@x1a0f3n9/dsh-user-approval": "workspace:^",
    "@x1a0f3n9/dsh-user-questions": "workspace:^",
    "@x1a0f3n9/dsh-workspace": "workspace:^",
    "auto-bind": "^4.0.0 || ^5.0.0",
    "bidi-js": "^1.0.0",
    "chalk": "^6.0.0",
    "cli-boxes": "^3.0.0 || ^4.0.0",
    "cli-highlight": "^2.1.11",
    "code-excerpt": "^3.0.0 || ^4.0.0",
    "diff": "^8.0.4",
    "dsh-working-activity": "^0.4.0",
    "emoji-regex": "^10.0.0",
    "figures": "^6.1.0",
    "get-east-asian-width": "^1.0.0",
    "highlight.js": "^11.11.1",
    "indent-string": "^5.0.0",
    "lodash-es": "^4.17.0",
    "marked": "^18.0.7",
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "semver": "^7.0.0",
    "signal-exit": "^4.0.0",
    "stack-utils": "^2.0.0",
    "strip-ansi": "^7.0.0",
    "supports-hyperlinks": "^3.0.0",
    "type-fest": "^5.8.0",
    "usehooks-ts": "^3.1.0",
    "wrap-ansi": "^10.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@x1a0f3n9/dsh-llm-pi-ai": "workspace:^",
    "@x1a0f3n9/dsh-persona": "workspace:^",
    "@x1a0f3n9/dsh-terminal": "workspace:^",
    "@x1a0f3n9/dsh-terminal-bash": "workspace:^",
    "@x1a0f3n9/dsh-tool-bash-persistent": "workspace:^",
    "@x1a0f3n9/dsh-tool-cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@dsh-std/command": "workspace:^",
    "@dsh-std/connection": "workspace:^",
    "@dsh-std/core": "workspace:^",
    "@dsh-std/manifest": "workspace:^",
    "@dsh-std/messages": "workspace:^",
    "@dsh-std/presentation": "workspace:^",
    "@dsh-std/storage": "workspace:^",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-reconciler": "^0.33.0",
    "@types/semver": "^7.0.0",
    "@x1a0f3n9/dsh-llm-pi-ai": "workspace:^",
    "@x1a0f3n9/dsh-persona": "workspace:^",
    "@x1a0f3n9/dsh-terminal": "workspace:^",
    "@x1a0f3n9/dsh-terminal-bash": "workspace:^",
    "@x1a0f3n9/dsh-tool-bash-persistent": "workspace:^",
    "@x1a0f3n9/dsh-tool-cordis": "workspace:^",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
