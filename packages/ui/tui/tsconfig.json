{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "types": ["node", "react"],
    "rootDir": "src",
    "outDir": "lib/types",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src"],
  "references": [
    { "path": "./tsconfig.dsh-std.json" },
    { "path": "../../core/agent" },
    { "path": "../../core/tools" },
    { "path": "../../core/session" },
    { "path": "../../core/system-prompt" },
    { "path": "../../llm/llm" },
    { "path": "../../interaction/commands" },
    { "path": "../../interaction/user-approval" },
    { "path": "../../interaction/user-questions" },
    { "path": "../../interaction/tool-ask-user" },
    { "path": "../../settings/settings" },
    { "path": "../../context/agent-instructions" },
    { "path": "../../skill/skill" },
    { "path": "../../storage/storage" },
    { "path": "../../workspace/workspace" },
    { "path": "../../extensions/cordis-host-runner" },
    { "path": "../../util/atomic-write" }
  ]
}
