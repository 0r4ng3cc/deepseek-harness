{
  "extends": "./vendor/dsh-std/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "./vendor/dsh-std/packages",
    "outDir": ".dsh-std-types",
    "tsBuildInfoFile": ".dsh-std-types/tsconfig.dsh-std.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "./vendor/dsh-std/packages/core/src/**/*.ts",
    "./vendor/dsh-std/packages/manifest/src/**/*.ts",
    "./vendor/dsh-std/packages/command/src/**/*.ts",
    "./vendor/dsh-std/packages/messages/src/**/*.ts",
    "./vendor/dsh-std/packages/presentation/src/**/*.ts",
    "./vendor/dsh-std/packages/storage/src/**/*.ts",
    "./vendor/dsh-std/packages/connection/src/**/*.ts"
  ]
}
